PORT=3000

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgres://chat:chat@localhost:5432/chat

# Firebase / Firestore
FIREBASE_PROJECT_ID=demo-chat

# Local development: talk to the Firestore emulator from docker-compose.yml.
# No Google credentials are needed while this is set.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Real Firebase project instead: remove FIRESTORE_EMULATOR_HOST above,
# set FIREBASE_PROJECT_ID to your project and point this at a service-account key.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
